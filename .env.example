# Names only. Copy to .env.local for local work and never commit real values. Worker secrets are set on each environment's Worker on
# its own, never shared: `npx wrangler secret put <NAME>` sets dev's (checkwork-dash-dev), `npx wrangler secret put <NAME> --env production`
# production's (checkwork-dash), or the Cloudflare dashboard (Workers, the Worker, Settings, Variables and secrets). NEXT_PUBLIC_ ones are
# inlined at build, so they are set where the build runs. CF_ACCESS_* are vars in wrangler.jsonc, one pair per environment.
# Never set CLOUDFLARE_ENV, in your shell or in .env / .env.local: the scripts refuse to run with it (dev is the default, production is --env production).

# ---- What kind of deploy this is ----
# "production" on the live deploy: the deploy's test run then fails while the finance figures are placeholders. Nothing a dealer sees
# follows it: a dealer the directory marks as a demo gets the made-up records, simulated services and the morning reset on any deploy,
# and any other dealer never does. What differs between dealers (name, website, phone, address, hours, logo, plan, stock source, rules,
# Google place, lead email) is each dealer's profile in the directory (docs/new-dealer.md).
APP_ENV=

# ---- Stock ----
# A long random secret the Worker's scheduled jobs send to the app (wrangler secret put CRON_KEY): the DoneDeal sync, the morning
# follow-up emails and WhatsApp alerts, the monthly report and the demo reset. Without it none runs on a schedule.
CRON_KEY=

# ---- Access ----
# Cloudflare Access: the Worker checks the signed token itself. The team domain (name.cloudflareaccess.com) and the application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# CI and E2E only: opens the app with no Access token so the E2E suite can test it. Never on a deploy.
NEXT_PUBLIC_ADMIN_OPEN=

# ---- Owner API (/api/owner, docs/owner-api.md) ----
# A long random Worker secret the owner's program sends as a Bearer token. Unset: the routes answer 404 to everyone.
OWNER_API_TOKEN=
# "1" adds sale values to the summary. Set it only when the dealer's contract allows.
OWNER_API_MONEY=

# ---- Dealer websites (docs/site-api.md) ----
# Signs the car photo links the site API gives a dealer's website (a Worker secret, 32 random bytes, its own per environment). Unset: the
# stock answer leaves out photos added in the dashboard and every photo link answers 404. Changing it ends the links given before.
SITE_PHOTO_SECRET=

# ---- Outside services (each is optional; Settings, Connected services lists what is still missing) ----
# A dealer's own accounts (listing site key, Google Business, Meta, ads customer id, WhatsApp, newsletter sending address) are not set here:
# the owner sets them per dealer in Settings, Your accounts. The settings below are ours.
# AI writing with Claude (a Worker secret). Unset: the mock writer (src/lib/ai/mock.ts).
ANTHROPIC_API_KEY=
# Google reviews (Places API New): our key. Each dealer's place is their profile's placeId. Unset means the demo reviews.
GOOGLE_PLACES_API_KEY=
# Registration lookup and history checks (One Auto API, Cartell's data in Ireland). Unset: the plate's own year and county only, and no
# history check (both simulated on a demo).
ONE_AUTO_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Newsletters and stock alerts, and the secret that signs their unsubscribe links (32 random bytes, never committed).
NEWSLETTER_API_KEY=
UNSUBSCRIBE_SECRET=
WHATSAPP_APP_SECRET=

# ---- Sign-in bot check (Cloudflare Turnstile, docs/sign-in.md) ----
# One widget for www.dash.checkwork.ie and dev.dash.checkwork.ie. The site key is public and inlined at build (deploy.yml sets it from the
# repo variable TURNSTILE_SITE_KEY). The secret is a Worker secret on each environment (wrangler secret put TURNSTILE_SECRET_KEY, add
# --env production). Secret unset: skipped in `next dev` and E2E, and "Email me a code" is refused on a deployed Worker. Test keys that
# always pass: site 1x00000000000000000000BB, secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Push notifications on team members' phones (#11, docs/dealer-admin.md) ----
# A VAPID key pair per environment, made by `node scripts/vapid-keys.mjs` (add --env production): the public key a var in wrangler.jsonc or a
# Worker secret, never both under the same name; the private key always a Worker secret (wrangler secret put VAPID_PRIVATE_KEY). Unset:
# Settings says notifications are not set up yet.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# This deploy's own address, for the links in its emails (a wrangler.jsonc var per environment; production's when unset).
APP_URL=

# ---- Dealers' own service keys (docs/dealer-admin.md, "Connecting a service") ----
# Seals the keys an owner pastes in Settings, Connected services (a Worker secret, 32 random bytes in base64, its own per environment):
# openssl rand -base64 32 | npx wrangler secret put DEALER_SECRETS_KEY   (add --env production for production)
# Unset: saving a key is refused with a plain message and nothing else changes. Losing it loses every saved key: keep a copy.
DEALER_SECRETS_KEY=
