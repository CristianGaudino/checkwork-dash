# Names only. Copy to .env.local for local work and never commit real values. Worker secrets go in the Cloudflare dashboard
# (Workers, Settings, Variables and secrets); NEXT_PUBLIC_ ones are inlined at build, so they are set where the build runs.

# ---- What kind of deploy this is ----
# "production" for real dealers: real emails, no simulated services, no demo records. Leave unset (or "demo") for a demo.
# What differs between dealers (name, website, phone, address, hours, logo, plan, stock source, rules, Google place, lead email) is
# not here: it is each dealer's profile in the directory (docs/new-dealer.md). The demo bar's switches count for a demo dealer only.
APP_ENV=
# The made-up leads, reviews, posts and team. On by default except on production. "on" for a production showcase, "off" for a demo
# that should start empty.
DEMO_RECORDS=
# Posts, ads, newsletters and the registration lookup act as if connected when they have no keys. On by default except on production;
# "off" shows "not connected" instead.
SIMULATE_INTEGRATIONS=

# ---- Stock ----
# DoneDeal's API key (a dealer whose profile says their stock is synced) (a secret; DoneDeal issues it with the dealer's written consent). Without it the sync says
# "not connected" (simulated on the demo, where the feed is the stock itself).
DONEDEAL_API_KEY=
# A long random secret the Worker's scheduled jobs send to the app (wrangler secret put CRON_KEY): the DoneDeal sync, the morning
# follow-up emails and WhatsApp alerts, the monthly report and the demo reset. Without it none runs on a schedule.
CRON_KEY=

# ---- Leads (stored here, sent by the dealer's website through the site API) ----
# Turnstile keys that check the bot token on a lead. The secret is a Worker secret; the site key is public.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Signs the lead photo links in the dealer email (HMAC, 7 days). A Worker secret: 32 random bytes, never committed.
PHOTO_LINK_SECRET=

# ---- Access ----
# Cloudflare Access: the Worker checks the signed token itself. The team domain (name.cloudflareaccess.com) and the application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# CI and E2E only: opens the app with no Access token so the E2E suite can test it. Never on a deploy.
NEXT_PUBLIC_ADMIN_OPEN=

# ---- Owner API (/api/owner, docs/owner-api.md) ----
# A long random Worker secret the owner's program sends as a Bearer token. Unset: the routes answer 404 to everyone.
OWNER_API_TOKEN=
# "1" adds sale values to the summary. Set it only when the dealer's contract allows.
OWNER_API_MONEY=

# ---- Outside services (each is optional; Settings, Connected services lists what is still missing) ----
# AI writing with Claude (a Worker secret). Unset: the mock writer (src/lib/ai/mock.ts).
ANTHROPIC_API_KEY=
# Google reviews (Places API New): our key. Each dealer's place is their profile's placeId. Unset means the demo reviews.
GOOGLE_PLACES_API_KEY=
# Replies to Google reviews (Google Business Profile API): the location ("accounts/<id>/locations/<id>") and an OAuth refresh token
# from its owner or a manager. Unset: replies simulated on a demo.
GOOGLE_BUSINESS_LOCATION=
GOOGLE_BUSINESS_REFRESH_TOKEN=
# Registration lookup (Cartell). Unset: the plate's own year and county only (simulated on a demo).
CARTELL_API_KEY=
# Facebook and Instagram posting.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ID=
# Ads (Meta and Google).
META_AD_ACCOUNT_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Newsletters and stock alerts, and the secret that signs their unsubscribe links (32 random bytes, never committed).
NEWSLETTER_API_KEY=
NEWSLETTER_FROM_EMAIL=
UNSUBSCRIBE_SECRET=
# WhatsApp Business (Cloud API). Unset: simulated on the demo.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
