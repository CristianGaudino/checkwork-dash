{
  "name": "checkwork-dash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate": "node scripts/migrate-dealers.mjs --remote",
    "db:migrate:prod": "node scripts/migrate-dealers.mjs --remote --env production",
    "directory:migrate": "node scripts/migrate-dealers.mjs --directory --remote",
    "directory:migrate:prod": "node scripts/migrate-dealers.mjs --directory --remote --env production",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/deploy.mjs",
    "deploy:prod": "node scripts/deploy.mjs --env production",
    "stock:build": "node scripts/stock/build.mjs",
    "stock:redate": "node scripts/stock/build.mjs redate",
    "stock:seed": "node scripts/stock/seed.mjs",
    "stock:reset": "node scripts/stock/seed.mjs --reset",
    "db:seed": "node scripts/seed-dealer.mjs checkwork-motors --remote",
    "db:seed:prod": "node scripts/seed-dealer.mjs checkwork-motors --remote --env production"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@opennextjs/cloudflare": "^1.20.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
